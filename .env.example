# ---- Telegram ----
# Create a bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=

# Optional: comma-separated chat ids that auto-receive pushed signals.
# Use /chatid in the bot to discover yours. New users are also added on /start.
TELEGRAM_CHAT_IDS=

# ---- Pocket Option (unofficial API) ----
# Full SSID auth string copied from the browser. Open Pocket Option, F12 ->
# Network -> WS, find the frame starting with 42["auth", and copy the WHOLE thing:
#   42["auth",{"session":"...","isDemo":1,"uid":123456,"platform":1}]
# Leave blank to run in DEMO mode with synthetic data (no real market data).
POCKET_OPTION_SSID=

# Use the Pocket Option demo balance (true) or real balance (false).
POCKET_OPTION_DEMO=true

# ---- Engine / strategy ----
# Comma-separated assets to scan (blank = sensible OTC default basket).
ASSETS=
# Candle timeframe in seconds: 60=M1, 300=M5, 900=M15.
TIMEFRAME=60
# Candles fetched per scan.
CANDLE_COUNT=120
# Seconds between automatic basket scans.
SCAN_INTERVAL=60
# Minimum confidence (0-100) required before a signal is pushed.
MIN_CONFIDENCE=65
# Suppress repeat signals for same asset+direction within this many seconds.
SIGNAL_COOLDOWN=300
# Start auto-push immediately on launch.
AUTOSTART_SIGNALS=true

LOG_LEVEL=INFO
